#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x591fbdb916b0 .scope module, "tb_circuit" "tb_circuit" 2 3;
 .timescale -9 -12;
v0x591fbdba4350_0 .var "a", 0 0;
v0x591fbdba4410_0 .var "b", 0 0;
v0x591fbdba44e0_0 .net "f", 0 0, v0x591fbdba3f70_0;  1 drivers
v0x591fbdba45e0_0 .net "g", 0 0, v0x591fbdba4040_0;  1 drivers
S_0x591fbdb91840 .scope module, "uut" "circuit" 2 7, 3 3 0, S_0x591fbdb916b0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "f";
    .port_info 3 /OUTPUT 1 "g";
v0x591fbdb57490_0 .net "a", 0 0, v0x591fbdba4350_0;  1 drivers
v0x591fbdba3eb0_0 .net "b", 0 0, v0x591fbdba4410_0;  1 drivers
v0x591fbdba3f70_0 .var "f", 0 0;
v0x591fbdba4040_0 .var "g", 0 0;
v0x591fbdba4100_0 .var "nand1", 0 0;
v0x591fbdba4210_0 .var "xor1", 0 0;
E_0x591fbdb57e20 .event anyedge, v0x591fbdb57490_0, v0x591fbdba3eb0_0, v0x591fbdba4210_0, v0x591fbdba4100_0;
    .scope S_0x591fbdb91840;
T_0 ;
    %wait E_0x591fbdb57e20;
    %load/vec4 v0x591fbdb57490_0;
    %load/vec4 v0x591fbdba3eb0_0;
    %xor;
    %assign/vec4 v0x591fbdba4210_0, 10000;
    %load/vec4 v0x591fbdb57490_0;
    %load/vec4 v0x591fbdba3eb0_0;
    %and;
    %inv;
    %assign/vec4 v0x591fbdba4100_0, 5000;
    %load/vec4 v0x591fbdb57490_0;
    %load/vec4 v0x591fbdba4210_0;
    %and;
    %inv;
    %assign/vec4 v0x591fbdba3f70_0, 5000;
    %load/vec4 v0x591fbdba4210_0;
    %load/vec4 v0x591fbdba4100_0;
    %xor;
    %assign/vec4 v0x591fbdba4040_0, 10000;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x591fbdb916b0;
T_1 ;
    %vpi_call 2 15 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x591fbdb916b0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x591fbdba4350_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x591fbdba4410_0, 0, 1;
    %delay 3000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x591fbdba4350_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x591fbdba4350_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x591fbdba4410_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x591fbdba4350_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x591fbdba4350_0, 0, 1;
    %delay 20000, 0;
    %vpi_call 2 30 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "19_sim.v";
    "19.v";
