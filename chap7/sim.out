    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5efb60adda90 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efb60aa4500_0, 0, 1;
