    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5efb60af0020_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efb60af0020_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5efb60af0020_0, 0, 1;
    %delay 30000, 0;
