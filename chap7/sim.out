E_0x5efb60aa5020 .event posedge, v0x5efb60aefc80_0;
    .scope S_0x5efb60addcc0;
T_0 ;
    %wait E_0x5efb60aa5020;
    %load/vec4 v0x5efb60aefd40_0;
    %assign/vec4 v0x5efb60aa4500_0, 0;
